POSTGRES_DB=codestart
POSTGRES_USER=codestart
POSTGRES_PASSWORD=
DJANGO_SECRET_KEY=
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Redis, the queue between the web app and the grader. Required: Compose
# will not start without a password. Use a long random value.
REDIS_PASSWORD=
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# Optional, only when two checkouts share one Docker (see README, "Two
# checkouts side by side"). Each checkout then needs its own values.
# COMPOSE_PROJECT_NAME=codestart
# SANDBOX_IMAGE=codestart-sandbox:1
# SANDBOX_LABEL=codestart.sandbox

# Optional: "runsc" to run sandboxes under gVisor, on a host where it is
# installed (see docs/grading-sandbox.md). Empty means Docker's default.
# SANDBOX_RUNTIME=
